# Скопируйте файл в .env и при необходимости измените значения:
#   cp .env.example .env

# --- База данных -----------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=service_center
POSTGRES_PASSWORD=service_center
POSTGRES_DB=service_center
# Порт, на котором PostgreSQL доступен с хост-машины
POSTGRES_EXTERNAL_PORT=5432

# --- Приложение ------------------------------------------------------------
APP_PORT=8000
DEBUG=false
# Автосоздание таблиц при старте. Для продуктива: false + alembic upgrade head
AUTO_CREATE_TABLES=true

# --- JWT -------------------------------------------------------------------
# ОБЯЗАТЕЛЬНО замените на случайную строку: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Бизнес-правила --------------------------------------------------------
ALLOW_SELF_REGISTRATION=true
MAX_ACTIVE_REQUESTS_PER_MASTER=10
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Ограничение частоты запросов к /auth ----------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Первый администратор (создаётся при первом запуске) -------------------
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin12345
FIRST_ADMIN_EMAIL=admin@service-center.local

# --- Логирование -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
